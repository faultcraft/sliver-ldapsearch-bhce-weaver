#!/usr/bin/env bash
# post-commit: push every commit to the VM_SHARED clone so files are visible on the host.

remote="vm_shared"
branch="$(git symbolic-ref --short HEAD 2>/dev/null)"

if [ -z "$branch" ]; then
    exit 0
fi

if git remote get-url "$remote" >/dev/null 2>&1; then
    git push "$remote" "$branch" --quiet 2>/dev/null || true
fi
